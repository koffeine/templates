{
	"compilerOptions": {
		// Modules
		"allowImportingTsExtensions": true,
		"module": "nodenext",
		"moduleResolution": "nodenext",
		"types": [],

		// Emit
		"noEmit": true,

		// JavaScript Support
		"allowJs": true,
		"checkJs": true,

		// Editor Support
		"plugins": [ { "name": "typescript-svelte-plugin" } ],

		// Interop Constraints
		"erasableSyntaxOnly": true,
		"verbatimModuleSyntax": true,

		// Language and Environment
		"target": "esnext",

		// Completeness
		"skipLibCheck": true
	},
	"exclude": [
		"dist",
		"node_modules"
	]
}
